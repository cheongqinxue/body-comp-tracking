# Google OAuth desktop client secrets JSON from GCP Console
GCP_OAUTH_CLIENT_SECRET_PATH=

# Optional: where to store the authorized user token (default: token.json)
GCP_OAUTH_TOKEN_PATH=

# Optional: default Google Spreadsheet title for GSheetEditor
GCP_SPREADSHEET_NAME=

# OpenAI-compatible inference server used for image extraction (vLLM default)
OPENAI_BASE_URL=http://localhost:8000/v1

# API key for the inference server (vLLM local default)
OPENAI_API_KEY=EMPTY

# Model name served by the inference server
EXTRACT_MODEL=numind/NuExtract3-W8A8
